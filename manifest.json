{
  "manifest_version": 3,
  "name": "Google Photos Folders",
  "version": "1.0.0",
  "description": "Organiza tus álbumes de Google Photos en carpetas anidadas automáticamente.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://photos.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://photos.google.com/*"],
      "js": [
        "gpf-ns.js",
        "gpf-utils.js",
        "gpf-network.js",
        "gpf-scrape.js",
        "gpf-ui.js",
        "gpf-render.js",
        "gpf-boot.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Google Photos Folders"
  }
}
